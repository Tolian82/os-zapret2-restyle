#!/bin/sh

# A clean plugin installation intentionally has no bol-van/zapret2 runtime yet.
# Boot must therefore stay silent until setup.sh has produced executable dvtws2.

CONFIGCTL="${CONFIGCTL:-/usr/local/sbin/configctl}"
DVTWS_BIN="${DVTWS_BIN:-/usr/local/etc/zapret2/binaries/my/dvtws2}"

[ -x "${DVTWS_BIN}" ] || exit 0

exec "${CONFIGCTL}" zapret start
