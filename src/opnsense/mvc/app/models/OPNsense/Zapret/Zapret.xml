<model>
    <mount>//OPNsense/Zapret</mount>
    <description>Zapret2 DPI Bypass Configuration</description>
    <version>2.0.0</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <waninterface type="InterfaceField">
                <Required>N</Required>
                <AllowDynamic>Y</AllowDynamic>
                <AddParentDevices>Y</AddParentDevices>
            </waninterface>
            <divertport type="PortField">
                <Default>989</Default>
                <Required>Y</Required>
                <ValidationMessage>Please enter a valid port number.</ValidationMessage>
            </divertport>
            <ports type="TextField">
                <Default>80,443</Default>
                <Required>Y</Required>
                <Mask>/^[0-9,]+$/</Mask>
                <ValidationMessage>Please enter comma-separated port numbers.</ValidationMessage>
            </ports>
        </general>
        <strategy>
            <!-- Legacy fields retained for migration from older configurations. -->
            <httpargs type="TextField">
                <Required>N</Required>
            </httpargs>
            <httpsargs type="TextField">
                <Required>N</Required>
            </httpsargs>
            <trafficargs type="TextField">
                <Required>N</Required>
            </trafficargs>
            <extraargs type="TextField">
                <Required>N</Required>
            </extraargs>
        </strategy>
        <voice>
            <!-- Empty Voice WAN inherits General WAN until a separate WAN is chosen.
                 This independent interface is not applied until profile isolation is qualified. -->
            <waninterface type="InterfaceField">
                <Required>N</Required>
                <AllowDynamic>Y</AllowDynamic>
                <AddParentDevices>Y</AddParentDevices>
            </waninterface>
            <telegram>
                <enabled type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </enabled>
                <args type="TextField">
                    <Required>N</Required>
                    <Default>--filter-udp=*&#10;--filter-l7=stun&#10;--payload=stun&#10;--lua-desync=fake:blob=0x00000000000000000000000000000000:repeats=2</Default>
                </args>
            </telegram>
            <discord>
                <enabled type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </enabled>
                <args type="TextField">
                    <Required>N</Required>
                </args>
            </discord>
            <x>
                <enabled type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </enabled>
                <args type="TextField">
                    <Required>N</Required>
                </args>
            </x>
            <sip>
                <enabled type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </enabled>
                <args type="TextField">
                    <Required>N</Required>
                </args>
            </sip>
            <custom>
                <enabled type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </enabled>
                <args type="TextField">
                    <Required>N</Required>
                </args>
            </custom>
        </voice>
        <strategylab>
            <enablequic type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enablequic>
        </strategylab>
        <hostlist>
            <mode type="OptionField">
                <Default>all</Default>
                <OptionValues>
                    <all>All traffic on configured ports</all>
                    <list>Only listed domains</list>
                    <auto>Auto-detect blocked domains</auto>
                </OptionValues>
                <Required>Y</Required>
            </mode>
            <!-- Legacy field retained for compatibility with existing config.xml. -->
            <domains type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9\.\*\-\n\r\s]*$/</Mask>
            </domains>
            <youtubedomains type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9\.\*\-\n\r\s]*$/</Mask>
            </youtubedomains>
            <telegramips type="TextField">
                <Required>N</Required>
                <Mask>/^[0-9\.\/\n\r\s]*$/</Mask>
                <ValidationMessage>Please enter one IPv4 address or CIDR network per line.</ValidationMessage>
            </telegramips>
            <discordips type="TextField">
                <Required>N</Required>
                <Mask>/^[0-9\.\/\n\r\s]*$/</Mask>
                <ValidationMessage>Please enter one IPv4 address or CIDR network per line.</ValidationMessage>
            </discordips>
            <xips type="TextField">
                <Required>N</Required>
                <Mask>/^[0-9\.\/\n\r\s]*$/</Mask>
                <ValidationMessage>Please enter one IPv4 address or CIDR network per line.</ValidationMessage>
            </xips>
            <sipips type="TextField">
                <Required>N</Required>
                <Mask>/^[0-9\.\/\n\r\s]*$/</Mask>
                <ValidationMessage>Please enter one IPv4 address or CIDR network per line.</ValidationMessage>
            </sipips>
            <customips type="TextField">
                <Required>N</Required>
                <Mask>/^[0-9\.\/\n\r\s]*$/</Mask>
                <ValidationMessage>Please enter one IPv4 address or CIDR network per line.</ValidationMessage>
            </customips>
            <userdomains type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9\.\*\-\n\r\s]*$/</Mask>
            </userdomains>
            <excludedomains type="TextField">
                <Required>N</Required>
                <Mask>/^[a-zA-Z0-9\.\*\-\n\r\s]*$/</Mask>
            </excludedomains>
        </hostlist>
    </items>
</model>
