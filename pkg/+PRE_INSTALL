#!/bin/sh

# Preserve the complete service state for every package replacement path,
# including forced reinstallations where pkg does not export PKG_UPGRADE.
# The incoming package's pre-install runs before the installed package's
# pre-deinstall, so a marker whose name is unknown to older hooks can carry the
# running state across the first upgrade to this implementation.

SERVICE_SCRIPT="${SERVICE_SCRIPT:-/usr/local/opnsense/scripts/OPNsense/Zapret/zapret_service.sh}"
UPGRADE_STATE_DIR="${UPGRADE_STATE_DIR:-/var/run/zapret2-restyle}"
UPGRADE_RESTART_MARKER="${UPGRADE_RESTART_MARKER:-${UPGRADE_STATE_DIR}/pkg-upgrade.restart}"
REPLACEMENT_RESTART_MARKER="${REPLACEMENT_RESTART_MARKER:-${UPGRADE_STATE_DIR}/pkg-replacement.restart}"
SHARED_APPLY_JOURNAL="${SHARED_APPLY_JOURNAL:-/var/db/zapret2/shared-apply/operation.json}"
LIFECYCLE_LOCK_FILE="${LIFECYCLE_LOCK_FILE:-/var/run/zapret2-lifecycle.lock}"
LOCKF_BIN="${LOCKF_BIN:-/usr/bin/lockf}"
KLDSTAT_BIN="${KLDSTAT_BIN:-/sbin/kldstat}"
IPFW_BIN="${IPFW_BIN:-/sbin/ipfw}"
PYTHON_BIN="${PYTHON_BIN:-/usr/local/bin/python3.13}"
COLD_INSPECT_BIN="${COLD_INSPECT_BIN:-/usr/local/opnsense/scripts/OPNsense/Zapret/backend/voice_live_inspect.py}"

# A test package can arrive while the INSTALLED (older) service has a
# committed, stopped common journal and NO ipfw/ipdivert kernel modules.
# The older service calls this "foreign rules" or "incomplete". Only a
# read-only, sealed native inspector and the exact FreeBSD ENOPROTOOPT
# cold-kernel signature can classify it as safely stopped for replacement.
# This is NOT a new runtime repair path; never load modules or clear a rule.
cold_committed_stopped()
{
    [ -r "$SHARED_APPLY_JOURNAL" ] &&
    [ -x "$LOCKF_BIN" ] &&
    [ -x "$PYTHON_BIN" ] &&
    [ -r "$COLD_INSPECT_BIN" ] &&
    [ -x "$KLDSTAT_BIN" ] &&
    [ -x "$IPFW_BIN" ] || return 1
    (
        "$LOCKF_BIN" -s -t 5 9 || exit 75
        "$KLDSTAT_BIN" -q -m ipfw >/dev/null 2>&1 && exit 1
        "$KLDSTAT_BIN" -q -m ipdivert >/dev/null 2>&1 && exit 1
        _preinstall_ipfw=$(LC_ALL=C "$IPFW_BIN" -q list 2>&1)
        _preinstall_rc=$?
        [ "$_preinstall_rc" -eq 71 ] || exit 1
        case "$_preinstall_ipfw" in *"Protocol not available"*) ;; *) exit 1 ;; esac
        _preinstall_inspection=$("$PYTHON_BIN" "$COLD_INSPECT_BIN" 2>/dev/null)
        _inspection_rc=$?
        [ "$_inspection_rc" -eq 2 ] || exit 1
        printf '%s\n' "$_preinstall_inspection" | "$PYTHON_BIN" -c '
import json,sys
try:
 x=json.load(sys.stdin)
 assert x.get("source")=="native-common"
 assert x.get("state")=="foreign-or-modified-rules"
 assert x.get("condition")=="common-stopped-with-kernel-objects"
 assert x.get("runtime",{}).get("state")=="stopped"
except (AssertionError,AttributeError,ValueError,TypeError):
 sys.exit(1)
'
    ) 9>"$LIFECYCLE_LOCK_FILE"
}

# Installed _22's direct status lacked FD9 when any journal existed.
# Incoming pre-install runs against the OLD installed service: retry
# status with its original FD9 only when normal inspection reports 2.
# A genuinely incomplete owner remains blocked without invoking stop.
read_service_status()
{
    "${SERVICE_SCRIPT}" status >/dev/null 2>&1
    _pkg_status=$?
    if [ "${_pkg_status}" -eq 2 ] &&
       [ -r "${SHARED_APPLY_JOURNAL}" ] &&
       [ -x "${LOCKF_BIN}" ] &&
       ! grep -Fq 'service_with_lifecycle_lock "${LIFECYCLE_LOCK_TIMEOUT}" "$@"' "${SERVICE_SCRIPT}"; then
        (
            "${LOCKF_BIN}" -s -t 5 9 || exit 75
            "${SERVICE_SCRIPT}" status >/dev/null 2>&1
        ) 9>"${LIFECYCLE_LOCK_FILE}"
        _pkg_status=$?
    fi
    # The old installed package's PRE-DEINSTALL runs AFTER this hook,
    # using its OLD service script. Its status still returns 2 in this exact
    # cold-kernel case, and it then calls stop on an unverified owner.
    # Thus detection is diagnostic only; a safe path must repair the OLD
    # runtime first. Never report status 1 here just to advance pkg.
    if [ "${_pkg_status}" -ne 0 ] && [ "${_pkg_status}" -ne 1 ] &&
       cold_committed_stopped; then
        echo "ERROR: old PRE-DEINSTALL cannot verify a stopped committed owner with IPFW unloaded; controlled recovery before package replacement is required" >&2
        return 69
    fi
    return "${_pkg_status}"
}


# No installed service script means a fresh installation or a repair of an
# already incomplete package. Neither case may inherit stale restart intent.
if [ ! -x "${SERVICE_SCRIPT}" ]; then
    rm -f "${UPGRADE_RESTART_MARKER}" "${REPLACEMENT_RESTART_MARKER}"
    exit 0
fi

read_service_status
service_status=$?

case "${service_status}" in
    0)
        mkdir -p "${UPGRADE_STATE_DIR}" || exit 1
        : > "${REPLACEMENT_RESTART_MARKER}" || exit 1
        ;;
    1)
        # Preserve an existing replacement marker when retrying an interrupted
        # package transaction whose earlier pre-install already stopped service.
        ;;
    2)
        # Never stop unverified runtime via legacy lifecycle.
        rm -f "${UPGRADE_RESTART_MARKER}" "${REPLACEMENT_RESTART_MARKER}"
        echo "ERROR: incomplete zapret lifecycle; review before package replacement" >&2
        exit 1
        ;;
    *)
        rm -f "${UPGRADE_RESTART_MARKER}" "${REPLACEMENT_RESTART_MARKER}"
        echo "ERROR: cannot determine zapret service state before package replacement" >&2
        exit 1
        ;;
esac

if [ "${service_status}" -ne 1 ]; then
    if ! "${SERVICE_SCRIPT}" stop >/dev/null 2>&1; then
        rm -f "${UPGRADE_RESTART_MARKER}" "${REPLACEMENT_RESTART_MARKER}"
        echo "ERROR: zapret service could not be stopped; package replacement aborted" >&2
        exit 1
    fi

    read_service_status
    stopped_status=$?
    if [ "${stopped_status}" -ne 1 ]; then
        rm -f "${UPGRADE_RESTART_MARKER}" "${REPLACEMENT_RESTART_MARKER}"
        echo "ERROR: zapret service still owns runtime state; package replacement aborted" >&2
        exit 1
    fi
fi

exit 0
