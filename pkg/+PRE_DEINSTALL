#!/bin/sh

# Stop the service before pkg removes the service scripts. During an upgrade,
# remember only a complete running state so the new post-install hook can start
# the service again with the replacement code. Runtime files, configuration,
# logs, and shared dependencies are intentionally preserved.

SERVICE_SCRIPT="/usr/local/opnsense/scripts/OPNsense/Zapret/zapret_service.sh"
UPGRADE_STATE_DIR="/var/run/zapret2-restyle"
UPGRADE_RESTART_MARKER="${UPGRADE_STATE_DIR}/pkg-upgrade.restart"

if [ -z "${PKG_UPGRADE:-}" ]; then
    rm -f "${UPGRADE_RESTART_MARKER}"
fi

if [ -x "${SERVICE_SCRIPT}" ]; then
    "${SERVICE_SCRIPT}" status >/dev/null 2>&1
    service_status=$?

    case "${service_status}" in
        0)
            if [ -n "${PKG_UPGRADE:-}" ]; then
                mkdir -p "${UPGRADE_STATE_DIR}" || exit 1
                : > "${UPGRADE_RESTART_MARKER}" || exit 1
            fi
            ;;
        1)
            # Preserve an existing marker when retrying an interrupted upgrade
            # whose earlier pre-deinstall already stopped the service.
            ;;
        2)
            # Incomplete runtime state still requires synchronous cleanup, but
            # it was not healthy and must not be auto-started after upgrade.
            rm -f "${UPGRADE_RESTART_MARKER}"
            ;;
        *)
            echo "ERROR: cannot determine zapret service state before package removal" >&2
            exit 1
            ;;
    esac

    if [ "${service_status}" -ne 1 ]; then
        if ! "${SERVICE_SCRIPT}" stop >/dev/null 2>&1; then
            rm -f "${UPGRADE_RESTART_MARKER}"
            echo "ERROR: zapret service could not be stopped; package operation aborted" >&2
            exit 1
        fi

        "${SERVICE_SCRIPT}" status >/dev/null 2>&1
        stopped_status=$?
        if [ "${stopped_status}" -ne 1 ]; then
            rm -f "${UPGRADE_RESTART_MARKER}"
            echo "ERROR: zapret service still owns runtime state; package operation aborted" >&2
            exit 1
        fi
    fi
fi

exit 0
