#!/bin/sh

# Post-install hook for os-zapret2-restyle.
# Reloads OPNsense services and renders the initial plugin configuration.

if [ -x /usr/local/etc/rc.d/configd ]; then
    /usr/local/etc/rc.d/configd restart >/dev/null 2>&1 || true
fi

if [ -x /usr/local/sbin/pluginctl ]; then
    /usr/local/sbin/pluginctl -c webgui.lighttpd_reload >/dev/null 2>&1 || true
fi

if [ -x /usr/local/sbin/configctl ]; then
    /usr/local/sbin/configctl template reload OPNsense/Zapret >/dev/null 2>&1 || true
fi

cat <<'NEXT_STEPS'

================================================================
os-zapret2-restyle installed.

Next steps:

  1. Open Services > Zapret DPI Bypass in the OPNsense GUI.

  2. Enable the service, select the WAN interface, configure
     Traffic Strategy and Targets, then click Apply.

The first GUI start automatically installs and compiles the zapret2 runtime
when it is not already present. No SSH setup command is required.

The internal OPNsense service name remains: zapret
================================================================
NEXT_STEPS

exit 0
