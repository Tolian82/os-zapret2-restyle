#!/bin/sh

# Register the plugin, load replacement configd actions, render the initial
# template, restore a previously running service during upgrade, and refresh
# the Web GUI last. Runtime preparation remains separate from the pkg
# transaction and is never started merely because the plugin was installed.

SERVICE_SCRIPT="/usr/local/opnsense/scripts/OPNsense/Zapret/zapret_service.sh"
CONFIGCTL="/usr/local/sbin/configctl"
SERVICE_BIN="/usr/sbin/service"
FIRMWARE_REGISTER="/usr/local/opnsense/scripts/firmware/register.php"
CONFIGURE_PLUGINS="/usr/local/etc/rc.configure_plugins"
UPGRADE_RESTART_MARKER="/var/run/zapret2-restyle/pkg-upgrade.restart"

[ -x "${FIRMWARE_REGISTER}" ] || {
    echo "ERROR: OPNsense plugin registration helper is unavailable" >&2
    exit 1
}

if ! "${FIRMWARE_REGISTER}" install os-zapret2-restyle; then
    echo "ERROR: os-zapret2-restyle could not be registered in OPNsense firmware state" >&2
    exit 1
fi

[ -x "${CONFIGURE_PLUGINS}" ] || {
    echo "ERROR: OPNsense plugin configuration helper is unavailable" >&2
    exit 1
}

if ! "${CONFIGURE_PLUGINS}" POST_INSTALL; then
    echo "ERROR: OPNsense POST_INSTALL plugin configuration failed" >&2
    exit 1
fi

[ -x "${SERVICE_BIN}" ] || {
    echo "ERROR: OPNsense service control is unavailable after plugin installation" >&2
    exit 1
}

if ! "${SERVICE_BIN}" configd restart >/dev/null 2>&1; then
    echo "ERROR: configd could not be restarted after plugin action installation" >&2
    exit 1
fi

[ -x "${CONFIGCTL}" ] || {
    echo "ERROR: OPNsense configd control is unavailable after plugin installation" >&2
    exit 1
}

template_output=$("${CONFIGCTL}" template reload OPNsense/Zapret 2>&1)
template_result=$?
if [ "${template_result}" -ne 0 ] || [ "${template_output}" != "OK" ]; then
    printf '%s\n' "${template_output}" >&2
    echo "ERROR: OPNsense Zapret template could not be rendered after plugin installation" >&2
    exit 1
fi

if [ -n "${PKG_UPGRADE:-}" ] && [ -f "${UPGRADE_RESTART_MARKER}" ]; then
    [ -x "${SERVICE_SCRIPT}" ] || {
        echo "ERROR: zapret service control is unavailable after package upgrade" >&2
        exit 1
    }

    service_output=$("${CONFIGCTL}" zapret start 2>&1)
    service_result=$?
    if [ "${service_result}" -ne 0 ] || [ "${service_output}" != "OK" ]; then
        printf '%s\n' "${service_output}" >&2
        echo "ERROR: zapret service could not be started after package upgrade" >&2
        exit 1
    fi

    if ! "${SERVICE_SCRIPT}" status >/dev/null 2>&1; then
        echo "ERROR: zapret service did not reach running state after package upgrade" >&2
        exit 1
    fi

    rm -f "${UPGRADE_RESTART_MARKER}"
fi

webgui_output=$("${CONFIGCTL}" webgui restart 2 2>&1)
webgui_result=$?
if [ "${webgui_result}" -ne 0 ] || [ "${webgui_output}" != "OK" ]; then
    printf '%s\n' "${webgui_output}" >&2
    echo "ERROR: OPNsense Web GUI could not be refreshed after plugin installation" >&2
    exit 1
fi

cat <<'MESSAGE'

os-zapret2-restyle was installed.

To install the zapret2 runtime, run:

/usr/local/opnsense/scripts/OPNsense/Zapret/setup.sh install

MESSAGE

exit 0
