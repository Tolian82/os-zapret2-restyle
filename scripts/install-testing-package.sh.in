#!/bin/sh
# Generated by the official testing-release publisher. Never run pkg inside
# any pkg installation hook. Resolve dependencies before stock local pkg add.
set -eu

PACKAGE_VERSION='@PACKAGE_VERSION@'
PACKAGE_SHA256='@PACKAGE_SHA256@'
PACKAGE_NAME="os-zapret2-restyle-${PACKAGE_VERSION}.pkg"
PACKAGE_URL="https://github.com/Tolian82/os-zapret2-restyle/releases/download/v${PACKAGE_VERSION}/${PACKAGE_NAME}"

fail() { printf 'REFUSED: %s\n' "$*" >&2; exit 1; }

case "${PACKAGE_VERSION}" in
  *[!0-9A-Za-z._-]*|'') fail 'invalid pinned package version' ;;
esac
case "${PACKAGE_SHA256}" in
  *[!0123456789abcdef]*|'') fail 'invalid pinned SHA-256' ;;
esac
[ "${#PACKAGE_SHA256}" -eq 64 ] || fail 'invalid pinned SHA-256 length'
command -v opnsense-version >/dev/null 2>&1 || fail 'requires a real OPNsense appliance'
command -v pkg >/dev/null 2>&1 || fail 'stock OPNsense pkg is unavailable'
command -v fetch >/dev/null 2>&1 || fail 'FreeBSD fetch is unavailable'
command -v sha256 >/dev/null 2>&1 || fail 'FreeBSD sha256 is unavailable'
command -v tar >/dev/null 2>&1 || fail 'FreeBSD tar is unavailable'
command -v php >/dev/null 2>&1 || fail 'native OPNsense PHP is unavailable'
[ "$(pkg config ABI)" = 'FreeBSD:15:amd64' ] || fail 'package requires FreeBSD:15:amd64'
case "$(opnsense-version -a)" in
  26.7*) ;;
  *) fail 'testing package is qualified only for OPNsense 26.7' ;;
esac

WORK=$(mktemp -d /tmp/zapret2-test-install.XXXXXXXX) || fail 'cannot create temporary directory'
trap 'rm -rf "$WORK"' EXIT HUP INT TERM
chmod 700 "$WORK"
PKG="$WORK/$PACKAGE_NAME"

if [ -n "${ZAPRET2_CI_LOCAL_ARCHIVE:-}" ]; then
    # A disposable CI guest tests the exact already-built archive before
    # publishing; this is not an owner-facing option. SHA still must match.
    [ "${GITHUB_ACTIONS:-}" = true ] && [ "${ZAPRET2_STAGE5_CROSS_VM:-}" = 1 ] ||
        fail 'local archive override is restricted to disposable CI'
    cp "${ZAPRET2_CI_LOCAL_ARCHIVE}" "$PKG" ||
        fail 'could not copy original CI archive'
else
    printf 'Fetching immutable testing candidate %s...\n' "$PACKAGE_NAME"
    fetch -q -T 90 -o "$PKG" "$PACKAGE_URL" ||
        fail 'GitHub asset fetch failed'
fi
ACTUAL_SHA=$(sha256 -q "$PKG") || fail 'cannot hash downloaded archive'
[ "$ACTUAL_SHA" = "$PACKAGE_SHA256" ] || fail 'published package SHA-256 mismatch; no pkg operation executed'

# pkg add is not a network dependency solver. Read the exact, SHA-bound native
# package manifest, never a handwritten dependency list or third-party repo.
MANIFEST="$WORK/manifest.json"
tar -xOf "$PKG" +MANIFEST > "$MANIFEST" || fail 'package manifest unavailable'
DEPS=$(php -r '
  $m = json_decode(file_get_contents($argv[1]), true);
  if (!is_array($m) || ($m["name"] ?? null) !== "os-zapret2-restyle"
      || ($m["version"] ?? null) !== $argv[2]
      || ($m["abi"] ?? null) !== "FreeBSD:15:amd64"
      || !is_array($m["deps"] ?? null) || !$m["deps"]) exit(2);
  $out = [];
  foreach (array_keys($m["deps"]) as $name) {
    if (!is_string($name) || !preg_match("/^[a-zA-Z0-9_+.-]+$/D", $name)) exit(3);
    $out[$name] = true;
  }
  echo implode(" ", array_keys($out));
' "$MANIFEST" "$PACKAGE_VERSION") || fail 'native package identity or dependency manifest is invalid'
[ -n "$DEPS" ] || fail 'empty native dependency plan'

# Already installed and adequate dependencies must not be passed explicitly
# to pkg install: doing so can change their automatic/manual pkgdb flag.
# Read required versions from the same SHA-pinned native manifest. pkg version
# -t performs FreeBSD package-version ordering (not lexicographic ordering).
REQUIREMENTS="$WORK/requirements"
php -r '
  $m = json_decode(file_get_contents($argv[1]), true);
  if (!is_array($m) || !is_array($m["deps"] ?? null)) exit(2);
  foreach ($m["deps"] as $name => $meta) {
    $version = $meta["version"] ?? null;
    if (!is_string($name) || !preg_match("/^[a-zA-Z0-9_+.-]+$/D", $name)
        || !is_string($version) || !preg_match("/^[a-zA-Z0-9_+.,:-]+$/D", $version)) exit(3);
    echo $name, " ", $version, PHP_EOL;
  }
' "$MANIFEST" > "$REQUIREMENTS" || fail 'invalid native dependency versions'
[ -s "$REQUIREMENTS" ] || fail 'empty native dependency requirements'
MISSING=''
while read -r dep required; do
    [ -n "$dep" ] && [ -n "$required" ] ||
        fail 'malformed native dependency requirement'
    installed=$(pkg query '%v' "$dep" 2>/dev/null) || installed=''
    if [ -n "$installed" ]; then
        comparison=$(pkg version -t "$installed" "$required") ||
            fail "cannot compare installed dependency $dep"
        case "$comparison" in
          '='|'>') continue ;;
          '<') ;;
          *) fail "unknown pkg version comparison for $dep" ;;
        esac
    fi
    MISSING="${MISSING:+$MISSING }$dep"
done < "$REQUIREMENTS"

if [ -n "$MISSING" ]; then
    printf 'Resolving missing/outdated dependencies from official OPNsense repository: %s\n' "$MISSING"
    set -f
    # Names were strictly validated from the SHA-pinned native manifest.
    # shellcheck disable=SC2086
    if [ -n "${ZAPRET2_CI_LOCAL_ARCHIVE:-}" ] && [ "${GITHUB_ACTIONS:-}" = true ] &&
       [ "${ZAPRET2_STAGE5_CROSS_VM:-}" = 1 ]; then
        pkg install -y -r OPNsense $MISSING ||
            fail 'CI official native dependency installation failed'
    else
        pkg install -r OPNsense $MISSING ||
            fail 'native dependency installation aborted or failed; plugin unchanged'
    fi
else
    printf 'All declared native dependencies are already installed; preserving automatic flags.\n'
fi

printf 'Installing verified local plugin archive with normal pkg scripts...\n'
pkg add -f "$PKG" || fail 'local package install failed; inspect native pkg output'
[ "$(pkg query '%v' os-zapret2-restyle)" = "$PACKAGE_VERSION" ] || fail 'installed package identity does not match'
pkg check -d os-zapret2-restyle || fail 'installed dependency database is inconsistent'
printf 'PASS: installed %s with normal pkg hooks and native OPNsense dependencies.\n' "$PACKAGE_VERSION"
